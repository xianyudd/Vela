# Line endings are declared here so a checkout in WSL and a checkout on Windows
# produce identical bytes. Without a declaration each machine's core.autocrlf
# setting decides, and the same commit can differ between developers.
#
# The policy mirrors .editorconfig ([*] end_of_line = lf): LF everywhere, with
# narrow exceptions for files a Windows tool owns and rewrites on its own.

* text=auto eol=lf

# Visual Studio always writes these with CRLF. Declaring LF would make it emit
# a whole-file diff every time the solution or publish profile is saved.
*.sln       text eol=crlf
*.pubxml    text eol=crlf

# cmd.exe can mis-parse an LF-only batch file.
*.cmd       text eol=crlf

# Generated by the .NET SDK and NuGet with CRLF, and never hand-edited. Left
# unnormalized so a restore on Windows cannot dirty the working tree, which
# matters because CI restores in --locked-mode.
packages.lock.json  -text
dotnet-tools.json   -text

# Binary assets: no end-of-line conversion, no attempt to diff as text.
*.png   binary
*.gif   binary
